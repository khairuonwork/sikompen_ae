APP_NAME="Sikompen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database lokal dari docker-compose.yml. Ganti password sebelum dipakai di server.
DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=kompen_database
DB_USERNAME=kompen_user
DB_PASSWORD=kompen_local_password

# Koneksi database Sikompen bersama. Tabel aplikasi ini memakai awalan
# sikompen_ agar tidak berbenturan dengan aplikasi lain.
KOMPEN_RESPON_HUB_DB_CONNECTION=kompen_db
KOMPEN_DB_URL=
KOMPEN_DB_HOST=127.0.0.1
KOMPEN_DB_PORT=3307
KOMPEN_DB_DATABASE=kompen_database
KOMPEN_DB_USERNAME=kompen_user
KOMPEN_DB_PASSWORD=kompen_local_password
# Hanya dipakai oleh service MariaDB pada docker-compose.yml. Ganti nilainya
# dengan password kuat sebelum deployment.
KOMPEN_DB_ROOT_PASSWORD=change_this_local_root_password

# Port publik Nginx dan URL aplikasi saat dijalankan melalui Docker Compose.
APP_PORT=8080
DOCKER_APP_URL=http://localhost:8080

SESSION_DRIVER=database
SESSION_CONNECTION=kompen_db
SESSION_TABLE=sikompen_sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=kompen_db
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
