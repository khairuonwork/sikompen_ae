APP_NAME="Sikompen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database lokal dari docker-compose.yml. Ganti password sebelum dipakai di server.
DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=kompen_database
DB_USERNAME=kompen_user
DB_PASSWORD=kompen_local_password

# Koneksi database Sikompen bersama. Tabel aplikasi ini memakai awalan
# sikompen_ agar tidak berbenturan dengan aplikasi lain.
KOMPEN_RESPON_HUB_DB_CONNECTION=kompen_db
KOMPEN_DB_URL=
KOMPEN_DB_HOST=127.0.0.1
KOMPEN_DB_PORT=3307
KOMPEN_DB_DATABASE=kompen_database
KOMPEN_DB_USERNAME=kompen_user
KOMPEN_DB_PASSWORD=kompen_local_password
# Hanya dipakai oleh service MariaDB pada docker-compose.yml. Ganti nilainya
# dengan password kuat sebelum deployment.
KOMPEN_DB_ROOT_PASSWORD=change_this_local_root_password

# Port publik Nginx dan URL aplikasi saat dijalankan melalui Docker Compose.
APP_PORT=8080
DOCKER_APP_URL=http://localhost:8080

SESSION_DRIVER=database
SESSION_CONNECTION=kompen_db
SESSION_TABLE=sikompen_sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=sikompen_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Batas defensif impor XLSX sesuai kapasitas workbook template Sikompen.
SIKOMPEN_IMPORT_MAX_UPLOAD_KILOBYTES=5120
SIKOMPEN_IMPORT_MAX_ARCHIVE_ENTRIES=64
SIKOMPEN_IMPORT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=8388608
SIKOMPEN_IMPORT_MAX_ARCHIVE_ENTRY_BYTES=4194304
SIKOMPEN_IMPORT_MAX_ARCHIVE_COMPRESSION_RATIO=100
SIKOMPEN_EXPORT_MAX_ROWS=5000
SIKOMPEN_EXPORT_RETENTION_HOURS=24
SIKOMPEN_IMPORT_TASK_RETENTION_DAYS=30
SIKOMPEN_STALLED_TASK_MINUTES=15
SIKOMPEN_QUEUED_TASK_MINUTES=60
SIKOMPEN_IMPORT_QUEUE=imports
SIKOMPEN_EXPORT_QUEUE=exports
SIKOMPEN_API_SYNC_QUEUE=api-sync
SIKOMPEN_API_SYNC_ARTIFACT_RETENTION_HOURS=24
SIKOMPEN_API_SYNC_RUN_RETENTION_DAYS=7
SIKOMPEN_API_SYNC_MAX_ARTIFACT_BYTES=268435456
SIKOMPEN_API_SYNC_MAX_UNCOMPRESSED_BYTES=536870912

# Provider API: daftar client dikelola dari environment, tanpa command atau
# record client yang perlu dikelola manual. Token mentah hanya dibagikan satu
# kali ke sistem peminta; jangan commit nilai asli. Gunakan [] bila peminta
# tidak memiliki IP egress statis; bila ada IP statis, isi IP/CIDR untuk lapis
# pembatas tambahan.
SIKOMPEN_API_CLIENTS_JSON='[{"key":"api-mini-local","token":"ganti-dengan-token-minimal-32-karakter","allowed_ips":["172.30.0.10/32"],"rate_limit_per_minute":30}]'

# Hanya alamat proxy pada network Docker yang boleh meneruskan header IP.
SIKOMPEN_TRUSTED_PROXY_CIDRS=172.30.0.0/24
SIKOMPEN_TRUSTED_PROXY_CIDR=172.31.0.0/24

# API Mini App hanya dipublikasikan di localhost; Cloudflare Tunnel akan menjadi
# satu-satunya jalur publik saat staging/production.
API_MINI_APP_PORT=8090
API_MINI_APP_IP=172.30.0.10
SIKOMPEN_NETWORK_NAME=sikompen_internal
SIKOMPEN_NETWORK_SUBNET=172.30.0.0/24
SIKOMPEN_PROXY_NETWORK_NAME=sikompen_proxy
SIKOMPEN_PROXY_NETWORK_SUBNET=172.31.0.0/24
SIKOMPEN_API_BASE_URL=http://web
SIKOMPEN_API_BEARER_TOKEN=

# Diisi hanya saat men-seed dua akun darurat untuk reset password admin.
# Jangan commit nilai asli atau menyimpan password ini di dokumentasi repository.
SIKOMPEN_EMERGENCY_ADMIN_1_USERNAME=
SIKOMPEN_EMERGENCY_ADMIN_1_PASSWORD=
SIKOMPEN_EMERGENCY_ADMIN_2_USERNAME=
SIKOMPEN_EMERGENCY_ADMIN_2_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=kompen_db
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database
DB_CACHE_CONNECTION=kompen_db
DB_CACHE_TABLE=sikompen_cache
DB_CACHE_LOCK_CONNECTION=kompen_db
DB_CACHE_LOCK_TABLE=sikompen_cache_locks
CACHE_PREFIX=sikompen-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
